# Telegram API Credentials (from https://my.telegram.org)
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# Generated interactively by running: python login.py
TELEGRAM_SESSION_STRING=

# Target channel handle or numeric ID (e.g. @my_channel or -1001234567890)
TELEGRAM_CHANNEL=@my_music_channel

# Optional comma-separated bot tokens for load-balanced streaming (up to 20 bots)
# Create bots via @BotFather and add them as Administrators to the channel
TELEGRAM_BOT_TOKENS=

# Server Port
PORT=3000

# Optional Secret URL Path Protection (e.g., secret123 -> all endpoints served under /secret123/)
URL_SECRET=

# Optional custom public URL if using reverse proxy or custom domain
PUBLIC_URL=

# Automatic Cloudflare Tunneling (True / False)
ENABLE_CLOUDFLARE_TUNNEL=True
